# === Credenciales de Claude (Anthropic) ===
# Obtenga su clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a utilizar. Por defecto el más capaz para redacción técnica/legal.
CLAUDE_MODEL=claude-opus-5

# Nivel de esfuerzo del modelo: low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# Máximo de tokens de salida para el informe
CLAUDE_MAX_TOKENS=16000

# === Servidor ===
PORT=3000

# Secreto para firmar la sesión (cambie por un valor aleatorio)
SESSION_SECRET=cambie-este-valor-por-uno-aleatorio

# === Datos por defecto de la concesionaria (opcional) ===
# Se usan para prellenar el formulario; el asesor puede sobreescribirlos.
DEFAULT_CIUDAD=San José
DEFAULT_SUCURSAL=
DEFAULT_FIRMANTE_NOMBRE=
DEFAULT_FIRMANTE_CARGO=Gerente de Servicio
DEFAULT_EMPRESA=
