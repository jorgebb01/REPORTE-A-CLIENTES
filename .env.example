# === Proveedor de IA ===
# 'gemini' (por defecto) o 'claude'
AI_PROVIDER=gemini

# === Gemini (Google AI Studio) ===
# Obtenga su clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=su-clave-de-google-ai-studio
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_TOKENS=16000

# === Claude (Anthropic) — solo si AI_PROVIDER=claude ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000

# === Servidor ===
PORT=3000

# Secreto para firmar la sesión (cambie por un valor aleatorio)
SESSION_SECRET=cambie-este-valor-por-uno-aleatorio

# === Datos por defecto de la concesionaria (opcional) ===
# Se usan para prellenar el formulario; el asesor puede sobreescribirlos.
DEFAULT_CIUDAD=San José
DEFAULT_SUCURSAL=
DEFAULT_FIRMANTE_NOMBRE=
DEFAULT_FIRMANTE_CARGO=Gerente de Servicio
DEFAULT_EMPRESA=
