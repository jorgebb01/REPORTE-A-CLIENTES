{
  "name": "reporte-a-clientes",
  "version": "1.0.0",
  "description": "Aplicación MVC para generar informes técnicos automotrices formales, profesionales y legalmente preventivos para clientes de una concesionaria, redactados por Claude con un formato único y repetible.",
  "main": "server.js",
  "bin": "entry.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:exe": "pkg . --targets node22-win-x64 --output dist/InformesTecnicos.exe --compress GZip --fallback-to-source"
  },
  "pkg": {
    "assets": [
      "src/views/**/*",
      "src/public/**/*",
      "node_modules/ejs/**/*"
    ],
    "scripts": [
      "src/**/*.js"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "informe-tecnico",
    "automotriz",
    "mvc",
    "claude",
    "concesionaria",
    "costa-rica"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/genai": "^2.19.0",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
